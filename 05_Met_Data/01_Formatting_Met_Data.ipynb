    "import pandas as pd\n",
    "from datetime import datetime\n",
    "import glob\n",
    "import os\n",
    "import sys\n",
    "\n",
    "# ---- CONFIGURATION ----\n",
    "INPUT_GLOB = r\"C:\\Users\\Hojung Yu\\Desktop\\vip_met\\*.csv\"   # all CSVs to process\n",
    "SKIPROWS = 11                                              # rows to skip at top of each CSV\n",
    "DATETIME_FORMAT = \"%Y-%m-%d %H:%M:%S\"                      # format used in the csv datetime column\n",
    "\n",
    "# column mappings (keys = friendly name used in this script; values = actual CSV column names)\n",
    "valid_columns = {\n",
    "    'datetime_utc': 'datetime',     # UTC datetime (string like 2024-06-01 00:00:00)\n",
    "    'datetime_lst': 'datetime_lst', # Local datetime string if present (we'll use this to form iy/id/it/imin)\n",
    "    'Tair': 't2m',                  # 2m air temp (°C) or (K) depending on your data\n",
    "    'pres': 'sp',                   # surface pressure (Pa)\n",
    "    'kdown': 'ssrd',                # surface shortwave radiation down (W m-2)\n",
    "    'Idown': 'strd',                # surface longwave radiation down (W m-2)\n",
    "    'fcld': 'tcc',                  # total cloud cover (0-1)\n",
    "    'rain': 'tp',                   # total precipitation (mm or m depending on your data)\n",
    "    'wdir': 'wdir10',               # wind direction (degrees)\n",
    "    'wspeed': 'ws10',               # wind speed (m s-1)\n",
    "    'RH': 'r2m',                    # relative humidity (0-1)\n",
    "    'Kdiff': 'dhi',                 # diffuse shortwave radiation (W m-2)\n",
    "    'Kdir': 'dni',                  # direct shortwave radiation (W m-2)\n",
    "}\n",
    "\n",
    "# --------- helpers ----------\n",
    "def extract_time_parts(dt_str, fmt):\n",
    "    \"\"\"\n",
    "    Returns (iy, id, it, imin) = (year, day-of-year, hour, minute)\n",
    "    \"\"\"\n",
    "    dt = datetime.strptime(dt_str, fmt)\n",
    "    return dt.year, dt.timetuple().tm_yday, dt.hour, dt.minute\n",
    "\n",
    "def check_required_columns(df, mapping):\n",
    "    missing = [csv_col for csv_col in mapping.values() if csv_col not in df.columns]\n",
    "    return missing\n",
    "\n",
    "# --------- main ----------\n",
    "def main():\n",
    "    csv_files = sorted(glob.glob(INPUT_GLOB))\n",
    "    if not csv_files:\n",
    "        print(f\"No CSV files matched pattern: {INPUT_GLOB}\")\n",
    "        sys.exit(1)\n",
    "\n",
    "    print(f\"Found {len(csv_files)} file(s). Processing...\\n\")\n",
    "\n",
    "    header = (\"%iy  id  it imin   Q*      QH      QE      Qs      Qf    Wind    RH     Td     press   rain    \"\n",
    "              \"Kdn    snow    ldown   fcld    wuh     xsmd    lai_hr  Kdiff   Kdir    Wd\\n\")\n",
    "\n",
    "    for csv_path in csv_files:\n",
    "        base, _ = os.path.splitext(csv_path)\n",
    "        out_txt = base + \"_formatted.txt\"\n",
    "\n",
    "        try:\n",
    "            df = pd.read_csv(csv_path, skiprows=SKIPROWS)\n",
    "        except Exception as e:\n",
    "            print(f\"[SKIP] {os.path.basename(csv_path)}: failed to read CSV ({e})\")\n",
    "            continue\n",
    "\n",
    "        missing = check_required_columns(df, valid_columns)\n",
    "        if missing:\n",
    "            print(f\"[SKIP] {os.path.basename(csv_path)}: missing required columns: {missing}\")\n",
    "            continue\n",
    "\n",
    "        # Use ALL rows (no filtering by selected_times)\n",
    "        df_use = df.copy()\n",
    "\n",
    "        # Build time parts from local datetime column if present, else fall back to UTC datetime\n",
    "        time_col = valid_columns['datetime_lst'] if valid_columns['datetime_lst'] in df_use.columns else valid_columns['datetime_utc']\n",
    "\n",
    "        def time_parts_safe(val):\n",
    "            try:\n",
    "                iy, id_, it_, imin = extract_time_parts(str(val), DATETIME_FORMAT)\n",
    "            except Exception:\n",
    "                # If a row has a bad datetime, set to sentinel and you can handle later\n",
    "                iy, id_, it_, imin = (-999, -999, -999, -999)\n",
    "            return pd.Series([iy, id_, it_, imin], index=['iy', 'id', 'it', 'imin'])\n",
    "\n",
    "        df_format = df_use.copy()\n",
    "        df_format[['iy', 'id', 'it', 'imin']] = df_format[time_col].apply(time_parts_safe)\n",
    "\n",
    "        # Unit conversions\n",
    "        df_format['pres_kPa'] = df_format[valid_columns['pres']] / 1000.0\n",
    "        df_format['r2m_pct'] = df_format[valid_columns['RH']] * 100.0\n",
    "\n",
    "        # Write out\n",
    "        rows_written = 0\n",
    "        with open(out_txt, 'w', newline='\\n') as f:\n",
    "            f.write(header)\n",
    "            for _, row in df_format.iterrows():\n",
    "                try:\n",
    "                    line = [\n",
    "                        int(row['iy']), int(row['id']), int(row['it']), int(row['imin']),\n",
    "                        *[-999.00]*5,  # Q*, QH, QE, Qs, Qf\n",
    "                        float(row[valid_columns['wspeed']]),    # Wind\n",
    "                        float(row['r2m_pct']),                  # RH (%)\n",
    "                        float(row[valid_columns['Tair']]),      # Td (air temp; adjust if needed by your convention)\n",
    "                        float(row['pres_kPa']),                 # press (kPa)\n",
    "                        float(row[valid_columns['rain']]),      # rain\n",
    "                        float(row[valid_columns['kdown']]),     # Kdn\n",
    "                        *[-999.00],                             # snow\n",
    "                        float(row[valid_columns['Idown']]),     # ldown\n",
    "                        float(row[valid_columns['fcld']]),      # fcld\n",
    "                        *[-999.0]*3,                            # wuh, xsmd, lai_hr\n",
    "                        float(row[valid_columns['Kdiff']]),     # Kdiff\n",
    "                        float(row[valid_columns['Kdir']]),      # Kdir\n",
    "                        float(row[valid_columns['wdir']]),      # Wd\n",
    "                    ]\n",
    "                    f.write(\" \".join(f\"{x:.2f}\" if isinstance(x, float) else str(x) for x in line) + \"\\n\")\n",
    "                    rows_written += 1\n",
    "                except Exception as e:\n",
    "                    # Skip bad rows but keep going\n",
    "                    continue\n",
    "\n",
    "        print(f\"[OK]  {os.path.basename(csv_path)}  ->  {os.path.basename(out_txt)}  ({rows_written} rows)\")\n",
    "\n",
    "    print(\"\\nFinished. Note: times in the output are derived from the CSV datetime column \"\n",
    "          f\"('{valid_columns.get('datetime_lst', 'datetime')}'). If that's local time and you need UTC, \"\n",
    "          \"adjust upstream accordingly.\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ]
  }
